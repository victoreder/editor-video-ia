# Worker no seu servidor — use OS MESMOS valores das variáveis da Vercel
# (Settings → Environment Variables do projeto).

# banco (o mesmo Postgres/Neon da Vercel)
DATABASE_URL=

# armazenamento (o mesmo MinIO). Se o worker roda na MESMA máquina do MinIO, pode usar
# o endereço interno (ex.: http://172.17.0.1:9000) — os links do navegador continuam
# sendo assinados com S3_ENDPOINT da Vercel.
S3_ENDPOINT=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_BUCKET=editor-video-ia
S3_REGION=us-east-1

# chaves de IA (as mesmas da Vercel)
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
ELEVENLABS_API_KEY=
GROQ_API_KEY=
PEXELS_API_KEY=
REPLICATE_API_TOKEN=

# quantos vídeos processa ao mesmo tempo (cada um usa ~2 CPUs e ~2 GB de RAM)
WORKER_CONCURRENCY=1
