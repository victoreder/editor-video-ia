# ---------------------------------------------------------------- acesso (obrigatório no deploy)
APP_PASSWORD=                 # senha para entrar no sistema; sem ela o deploy fica bloqueado
APP_API_TOKEN=                # opcional: token (16+ caracteres) para o MCP/scripts usarem a API
AUTH_SECRET=                  # opcional: chave das sessões (padrão: derivada da senha)

# ---------------------------------------------------------------- IA
ANTHROPIC_API_KEY=            # IA diretora Claude (padrão)
ANTHROPIC_MODEL=claude-opus-5-5
OPENAI_API_KEY=               # IA diretora OpenAI, whisper-1 e imagens
OPENAI_MODEL=gpt-5
DIRECTOR=claude               # claude | openai | heuristic

# ---------------------------------------------------------------- transcrição
ELEVENLABS_API_KEY=           # Scribe (recomendado)
GROQ_API_KEY=                 # whisper-large-v3-turbo (mais barato)
TRANSCRIBER=                  # elevenlabs | groq | openai | script (vazio = o melhor disponível)
TRANSCRIBE_LANGUAGE=pt

# ---------------------------------------------------------------- B-roll
PEXELS_API_KEY=
REPLICATE_API_TOKEN=          # opcional (Flux)
BROLL_AI=0                    # 1 = gerar imagem por IA quando o banco não tiver
BROLL_AI_VIDEO=0              # 1 = gerar VÍDEO por IA (Replicate) para tela cheia/split — caro
REPLICATE_VIDEO_MODEL=minimax/video-01

# ---------------------------------------------------------------- música
MUSIC_AI=1                    # trilha por IA (ElevenLabs Music, usa ELEVENLABS_API_KEY); sem chave = sintetizada
ELEVENLABS_MUSIC_MODEL=music_v1

# ---------------------------------------------------------------- infraestrutura
# Fase 1 (Vercel): STORAGE=vercel-blob, DB=supabase, RUNNER=vercel-sandbox
# Fase 3 (VPS):    STORAGE=s3 (MinIO), DB=supabase ou local, RUNNER=local
STORAGE=local                 # local | vercel-blob | s3
DB=                           # vazio = automático: postgres (se DATABASE_URL) | supabase | local
DATABASE_URL=                 # Postgres da Vercel/Neon (criada pela Vercel ao conectar o banco)
RUNNER=                       # vazio = local (na Vercel: vercel-sandbox) · local | vercel-sandbox | inline | queue (VPS: worker/daemon.ts)
WORKER_CONCURRENCY=1          # jobs simultâneos por worker (RUNNER=queue)
RENDER_MEDIA_BASE_URL=        # como o render enxerga o storage (ex.: http://minio:9000 no Docker)
DATA_DIR=.data
PUBLIC_BASE_URL=http://localhost:3000

BLOB_READ_WRITE_TOKEN=
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

S3_ENDPOINT=                  # ex.: http://minio:9000
S3_REGION=us-east-1
S3_BUCKET=editor-video-ia
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_PUBLIC_URL=                # URL pública do bucket (o navegador lê daqui)

# Vercel Sandbox (RUNNER=vercel-sandbox): o worker clona o repo e roda lá
GIT_REPO_URL=                 # vazio na Vercel = o repositório do próprio deploy
GIT_REVISION=                 # vazio = o mesmo commit do deploy
GIT_TOKEN=                    # repositório privado: token do GitHub com leitura (Contents: read)
GIT_USERNAME=x-access-token
SANDBOX_VCPUS=4

# ---------------------------------------------------------------- render
RENDERER=local                # local | vercel (@remotion/vercel)
REMOTION_BROWSER_EXECUTABLE=  # Chromium já instalado (opcional)
RENDER_CONCURRENCY=
REMOTION_LICENSE_KEY=         # obrigatório para empresas com mais de 3 pessoas

# ---------------------------------------------------------------- MCP (edição por chat no Claude Code/Desktop)
EDITOR_URL=http://localhost:3000
EDITOR_TOKEN=                 # o mesmo valor de APP_API_TOKEN
